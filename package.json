{
  "name": "sinav-kampi",
  "version": "1.3.0",
  "private": true,
  "description": "6. sınıf kişisel sınav hazırlık uygulaması — çevrimdışı web ve Android",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/core.test.mjs tests/ai-core.test.mjs",
    "android": "npm run build && ./gradlew assembleDebug",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sinav-kampi \"node tests/firestore.test.mjs\"",
    "test:browser": "node tests/browser.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test:cloud": "firebase emulators:exec --only auth,firestore --project demo-sinav-kampi \"node tests/cloud-browser.mjs\""
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/manrope": "^5.2.5",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "esbuild": "^0.25.12",
    "firebase-tools": "^14.27.0"
  }
}
